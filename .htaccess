# YZA — static site (yza-shop.com)
Options -Indexes
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- Canonical: strip a bare "index.html" from the visible URL (old
  # internal links, bookmarks, shared links) so it never outranks "/" ----
  RewriteRule ^index\.html$                              /                          [R=301,L]
  RewriteRule ^blogs/journal/index\.html$                 /journal                   [R=301,L]
  RewriteRule ^blogs/journal/([a-zA-Z0-9-]+)/index\.html$ /blogs/journal/$1/         [R=301,L]

  # ---- Clean URLs: category pages (extensionless, query-string driven) ----
  RewriteRule ^collections/charms/?$             collections-seo.php?cat=charms [QSA,L]
  RewriteRule ^collections/sacs/?$                collections-seo.php?cat=bags [QSA,L]
  RewriteRule ^collections/pret-a-porter/?$      collections-seo.php?cat=rtw [QSA,L]
  RewriteRule ^collections/bijoux/?$              collections-seo.php?cat=accessories [QSA,L]
  RewriteRule ^collections/boucles-d-oreilles/?$ collections-seo.php?cat=earrings [QSA,L]
  RewriteRule ^collections/colliers/?$            collections-seo.php?cat=necklaces [QSA,L]
  RewriteRule ^collections/hauts/?$               collections-seo.php?cat=tops [QSA,L]
  RewriteRule ^collections/jupes-pareo/?$         collections-seo.php?cat=pareos [QSA,L]
  RewriteRule ^collections/pantalons/?$           collections-seo.php?cat=pants [QSA,L]
  RewriteRule ^collections/bas/?$                 collections-seo.php?cat=bottoms [QSA,L]

  # ---- /lookbook removed at client request (2026-07-04). She now sends the
  # lookbook privately over WhatsApp. Redirect any lingering links to home so
  # a shared URL never 404s. The lookbook assets themselves stay under
  # /assets/lookbook-ss26-27/ for private distribution / download.
  RewriteRule ^lookbook/?$                        /                          [R=301,L]

  # ---- Clean URLs: product detail pages ----
  RewriteRule ^produits/([a-zA-Z0-9-]+)/?$        produit-seo.php?handle=$1 [QSA,L]

  # ---- Clean URLs: pages whose slug differs from the filename ----
  RewriteRule ^grossistes/?$        b2b.html [L]
  RewriteRule ^mentions-legales/?$  legal.html [L]
  RewriteRule ^favoris/?$           favoris.html [L]
  RewriteRule ^journal/?$           blogs/journal/ [L]

  # ---- WordPress back-office lives in /wp (orders inbox for the WooCommerce
  # app). People type /wp-admin by habit — send them to the real login. ----
  RewriteRule ^wp-admin(/.*)?$   /wp/wp-admin/ [R=301,L]
  RewriteRule ^wp-login\.php$    /wp/wp-login.php [R=301,L]
  # The WooCommerce / WordPress app probes the REST API at the ROOT (/wp-json). WP lives
  # in /wp, so root /wp-json 404s and the app "receives an unexpected response". Forward it
  # to the real REST base (/wp/wp-json answers 200 JSON) so the app connects even when the
  # store address is entered without /wp. 302 so the app follows and re-bases to /wp/wp-json.
  RewriteRule ^wp-json(/.*)?$    /wp/wp-json$1 [R=302,QSA,L]

  # ---- Clean URLs: generic — /{name} serves {name}.html when that file exists.
  # Covers /collections, /lookbook, /studio, /histoire, /yza-girls, /contact, /faq
  # without a rule per page. /dashboard is excluded on purpose (stays .html-only).
  RewriteCond %{REQUEST_URI} !^/dashboard
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]

  # ---- Legacy Shopify URLs -> new static site (so old Google results / bookmarks
  # don't hit a 404). Runs last so it only catches genuinely-unknown legacy paths —
  # bare /collections is already handled by the generic rule above, and the clean
  # /collections/{category} routes further up already matched and exited by [L].
  RewriteRule ^collections/.+$           /collections.html [R=301,L]
  RewriteRule ^products/.+$              /collections.html [R=301,L]
  RewriteRule ^pages/.+$                 /                 [R=301,L]
  RewriteRule ^(cart|account|checkout)(/.*)?$ /            [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg   "access plus 1 month"
  ExpiresByType image/png    "access plus 1 month"
  ExpiresByType image/webp   "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4    "access plus 1 month"
  # Code carries a ?v= version query bumped on every deploy, and HTML is sent
  # no-cache, so a new deploy always references a fresh URL — the old cached file
  # is never reused. That makes long immutable caching safe AND keeps updates instant.
  ExpiresByType text/css     "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Long, immutable cache on code (mod_expires alone is overridden by the host's
# static default). mod_headers "set" takes final precedence. Safe because code
# is ?v=-versioned per deploy and HTML is no-cache, so a new version = new URL;
# this removes the per-navigation revalidation round-trips that stalled mobile.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must never be cached at the server/CDN layer (LiteSpeed's own LSCache,
  # separate from the hcdn edge, was found serving a stale pre-migration
  # WordPress snapshot of "/" to some browsers weeks after the WP install was
  # removed — X-LiteSpeed-Cache-Control is the documented way to opt an
  # .htaccess-only site out of LSCache without the WP plugin present).
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>

  # Baseline security headers (audit: only upgrade-insecure-requests was present).
  # HSTS is safe here because HTTPS is force-enabled at the Hostinger panel.
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Belt-and-braces noindex on the WP back-office paths. WordPress adds a noindex
  # <meta> once it's rendered, but a header stops any crawler that briefly indexes
  # a login form. Non-authoritative for the app itself; only affects search.
  <If "%{REQUEST_URI} =~ m#^/wp/(wp-login\.php|wp-admin/?)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Deny commonly-probed exposed files that don't need to exist here. WordPress
# xmlrpc.php is intentionally NOT blocked — Jetpack + the WooCommerce mobile app
# need it (breaking it would kill the client's push notifications).
<FilesMatch "^(\.env|\.env\..*|wp-config\.php\.bak|wp-config\.php\.old|wp-config\.php\.save|\.htpasswd|\.git.*|composer\.(json|lock)|package\.(json|lock)|README\.md|LICENSE|CHANGELOG.*)$">
  Require all denied
</FilesMatch>
<DirectoryMatch "\.git(/.*)?$">
  Require all denied
</DirectoryMatch>

# Private data store (subscriber emails/phones, pending carts, rate-limit files).
# Denied at the app level so protection travels with the repo — not only the host
# panel's dot-path rule. Each stored file also opens with "<?php exit;" (belt-and-braces).
<DirectoryMatch "\.private(/.*)?$">
  Require all denied
</DirectoryMatch>
RedirectMatch 403 (?i)^/\.private(/|$)

# Note: HTTPS is handled at the Hostinger panel level ("Force HTTPS").
# A redirect rule is intentionally omitted here to avoid a loop if SSL
# is still provisioning.
